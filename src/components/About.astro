---
import { about } from "../data/site";
---

<section id="nosotros" class="mx-auto max-w-4xl px-6 py-24 text-center">
	<p class="text-sm uppercase tracking-[0.3em] text-gold-dark">
		{about.eyebrow}
	</p>
	<h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">
		{about.headline}
	</h2>
	<p class="mx-auto mt-6 max-w-2xl text-ink/70">{about.body}</p>

	<div class="mt-14 grid gap-10 sm:grid-cols-3">
		{about.stats.map((stat) => (
			<div>
				<p class="font-serif text-3xl text-gold-dark">{stat.value}</p>
				<p class="mt-2 text-sm text-ink/60">{stat.label}</p>
			</div>
		))}
	</div>
</section>
