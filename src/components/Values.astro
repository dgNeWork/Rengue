---
import { values } from "../data/site";
---

<section class="mx-auto max-w-6xl px-6 py-24">
	<div class="grid gap-10 sm:grid-cols-3">
		{values.map((value) => (
			<div class="rounded-2xl border border-ink/10 p-8 text-center">
				<h3 class="font-serif text-xl text-ink">{value.title}</h3>
				<p class="mt-3 text-sm text-ink/70">{value.text}</p>
			</div>
		))}
	</div>
</section>
