---
import { Image } from "astro:assets";
import logoMark from "../assets/logo-mark.jpg";
import { nav, site } from "../data/site";
---

<header class="fixed inset-x-0 top-0 z-50 bg-cream/90 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
		<a href="#" class="flex items-center gap-3">
			<Image
				src={logoMark}
				alt=""
				role="presentation"
				width={44}
				height={44}
				class="h-11 w-11 rounded-full"
			/>
			<span class="font-script text-3xl text-ink">{site.name}</span>
		</a>

		<nav class="hidden gap-8 md:flex">
			{nav.map((link) => (
				<a
					href={link.href}
					class="text-sm font-medium text-ink/80 transition hover:text-gold-dark"
				>
					{link.label}
				</a>
			))}
		</nav>

		<a
			href="#contacto"
			class="hidden rounded-full bg-ink px-5 py-2 text-sm font-medium text-cream transition hover:bg-gold-dark md:inline-block"
		>
			Escríbenos
		</a>
	</div>
</header>
