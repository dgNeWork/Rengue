---
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<Layout title={`${title} | ${site.name}`}>
	<Header />
	<main class="mx-auto max-w-3xl px-6 pt-32 pb-24">
		<h1 class="font-serif text-3xl text-ink sm:text-4xl">{title}</h1>
		<div class="prose-legal mt-8 space-y-6 text-ink/80">
			<slot />
		</div>
		<a
			href="/"
			class="mt-12 inline-block text-sm underline hover:text-gold-dark"
		>
			← Volver a la portada
		</a>
	</main>
	<Footer />
</Layout>

<style>
	.prose-legal :global(h2) {
		margin-top: 2rem;
		margin-bottom: 0.5rem;
		font-family: var(--font-serif);
		font-size: 1.25rem;
		color: var(--color-ink);
	}
	.prose-legal :global(p) {
		line-height: 1.7;
	}
	.prose-legal :global(a) {
		text-decoration: underline;
	}
</style>
